    font-size: 0.8rem;
    font-weight: 700;
  }

  input,
  textarea {
    width: 100%;
    padding: 0.75rem;
    border: 1px solid var(--ink);
    border-radius: 0;
    background: var(--paper);
  }

  input:focus,
  textarea:focus {
