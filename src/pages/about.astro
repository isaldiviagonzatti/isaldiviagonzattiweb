---
import AboutContent from '../components/AboutContent.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import avatar from '../assets/avatar.jpg';
---

<BaseLayout title="About" description="About Ignacio Saldivia Gonzatti">
  <header class="page-header about-header">
    <div>
      <h1>About</h1>
      <p class="lede">PhD Candidate Food Security and Climate Services</p>
      <SocialLinks />
    </div>
    <img src={avatar.src} alt="Ignacio Saldivia Gonzatti" width="680" height="680" />
  </header>

  <AboutContent />
</BaseLayout>

<style>
  .about-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 9rem;
    align-items: end;
    gap: 2rem;
  }

  .about-header h1 {
    margin-bottom: 1rem;
  }

  .about-header :global(.social-links) {
    margin-top: 2rem;
  }

  .about-header img {
    aspect-ratio: 1;
    border-radius: 0.5rem;
    filter: grayscale(1);
    object-fit: cover;
  }

  @media (max-width: 38rem) {
    .about-header {
      grid-template-columns: 1fr;
    }

    .about-header img {
      width: 7rem;
      grid-row: 1;
    }
  }
</style>
