---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const entries = (await getCollection('anthology')).sort((a, b) =>
  a.data.title.localeCompare(b.data.title, undefined, { sensitivity: 'base' })
);

const items = await Promise.all(
  entries.map(async (entry) => {
    const { Content } = await render(entry);
    return { entry, Content };
  })
);

const authors = [...new Set(entries.flatMap((entry) => entry.data.authors))].sort((a, b) =>
  a.localeCompare(b, undefined, { sensitivity: 'base' })
);
const types = [...new Set(entries.map((entry) => entry.data.type))].sort();
---

<BaseLayout title="Anthology" description="A personal collection of poems, excerpts, and other writing." wide>
  <header class="page-header anthology-header">
    <div>
      <h1>Anthology</h1>
    </div>
    <p class="lede">A collection of my favourite poems, excerpts from books, and other writings.</p>
  </header>

  <div class="filters" aria-label="Filter anthology">
    <label>
      <span>Search</span>
      <input id="anthology-search" type="search" placeholder="Title, author, or words" autocomplete="off" />
    </label>
    <label>
      <span>Author</span>
      <select id="anthology-author">
        <option value="">All authors</option>
        {authors.map((author) => <option value={author}>{author}</option>)}
      </select>
    </label>
    <label>
      <span>Type</span>
      <select id="anthology-type">
        <option value="">All types</option>
        {types.map((type) => <option value={type}>{type}</option>)}
      </select>
    </label>
    <button id="anthology-reset" type="button">Reset</button>
  </div>

  <div class="result-line" aria-live="polite">
    <span id="anthology-count">{items.length} entries</span>
  </div>

  <div id="anthology-list" class="anthology-list">
    {items.map(({ entry, Content }) => (
      <details
        class="anthology-entry"
        data-authors={entry.data.authors.join('|')}
        data-type={entry.data.type}
      >
        <summary>
          <span class="entry-title">{entry.data.title}</span>
          <span class="entry-author">{entry.data.authors.join(' & ')}</span>
        </summary>
        <div class="entry-body prose">
          <Content />
          {(entry.data.work || entry.data.year) && (
            <dl class="entry-meta">
              {entry.data.work && <><dt>Work</dt><dd>{entry.data.work}</dd></>}
              {entry.data.year && <><dt>Year</dt><dd>{entry.data.year}</dd></>}
            </dl>
          )}
        </div>
      </details>
    ))}
  </div>

  <p id="anthology-empty" class="empty-message" hidden>No entries match those filters.</p>

  <script>
    const search = document.querySelector<HTMLInputElement>('#anthology-search');
    const author = document.querySelector<HTMLSelectElement>('#anthology-author');
    const type = document.querySelector<HTMLSelectElement>('#anthology-type');
    const reset = document.querySelector<HTMLButtonElement>('#anthology-reset');
    const count = document.querySelector<HTMLElement>('#anthology-count');
    const empty = document.querySelector<HTMLElement>('#anthology-empty');
    const entries = [...document.querySelectorAll<HTMLDetailsElement>('.anthology-entry')];

    const normalize = (value: string) =>
      value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();

    const update = () => {
      if (!search || !author || !type || !count || !empty) return;

      const query = normalize(search.value);
      const selectedAuthor = normalize(author.value);
      const selectedType = normalize(type.value);
      let visible = 0;

      entries.forEach((entry) => {
        const entryAuthors = normalize(entry.dataset.authors ?? '').split('|');
        const entryType = normalize(entry.dataset.type ?? '');
        const text = normalize(entry.textContent ?? '');
        const matches =
          (!query || text.includes(query)) &&
          (!selectedAuthor || entryAuthors.includes(selectedAuthor)) &&
          (!selectedType || entryType === selectedType);

        entry.hidden = !matches;
        if (matches) visible += 1;
      });

      count.textContent = `${visible} ${visible === 1 ? 'entry' : 'entries'}`;
      empty.hidden = visible !== 0;
    };

    search?.addEventListener('input', update);
    author?.addEventListener('change', update);
    type?.addEventListener('change', update);
    reset?.addEventListener('click', () => {
      if (!search || !author || !type) return;
      search.value = '';
      author.value = '';
      type.value = '';
      update();
      search.focus();
    });
  </script>
</BaseLayout>

<style>
  .anthology-header {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: end;
    gap: 3rem;
  }

  .filters {
    display: grid;
    grid-template-columns: minmax(13rem, 2fr) minmax(10rem, 1fr) minmax(8rem, 0.7fr) auto;
    align-items: end;
    gap: 1rem;
    padding: 0 0 1.5rem;
    border-bottom: 1px solid var(--line);
  }

  .filters label span {
    display: block;
    margin-bottom: 0.35rem;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .filters input,
  .filters select,
  .filters button {
    width: 100%;
    min-height: 2.75rem;
    padding: 0.55rem 0.65rem;
    border: 1px solid var(--line);
    border-radius: 0;
    background: var(--paper);
  }

  .filters input:focus,
  .filters select:focus,
  .filters button:focus {
    border-color: var(--ink);
    outline: 1px solid var(--ink);
    outline-offset: 1px;
  }

  .filters button {
    width: auto;
    border-color: var(--ink);
    cursor: pointer;
  }

  .result-line {
    padding-block: 0.75rem 1.25rem;
    color: var(--muted);
    font-size: 0.8rem;
    text-align: right;
  }

  .anthology-entry + .anthology-entry {
    margin-top: 0.2rem;
  }

  .anthology-entry[open] {
    margin-bottom: 1.5rem;
  }

  .anthology-entry[hidden] {
    display: none;
  }

  .anthology-entry summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(10rem, 0.4fr);
    gap: 2rem;
    padding-block: 1rem;
    cursor: pointer;
    list-style: none;
  }

  .anthology-entry summary::-webkit-details-marker {
    display: none;
  }

  .anthology-entry summary::before {
    content: '+';
    grid-column: 3;
    grid-row: 1;
    font-weight: 400;
  }

  .anthology-entry[open] summary::before {
    content: '−';
  }

  .entry-title {
    font-weight: 650;
  }

  .entry-author {
    color: var(--muted);
  }

  .entry-body {
    max-width: 44rem;
    padding: 0.75rem 0 3rem;
  }

  .entry-body :global(p:last-child) {
    margin-bottom: 0;
  }

  .entry-meta {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.25rem 1rem;
    margin: 2rem 0 0;
    color: var(--muted);
    font-size: 0.85rem;
  }

  .entry-meta dt {
    font-weight: 700;
  }

  .entry-meta dd {
    margin: 0;
  }

  .empty-message {
    padding-block: 3rem;
    color: var(--muted);
  }

  @media (max-width: 52rem) {
    .anthology-header,
    .filters {
      grid-template-columns: 1fr 1fr;
    }

    .filters label:first-child {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 38rem) {
    .anthology-header,
    .filters,
    .anthology-entry summary {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .anthology-entry summary::before {
      display: none;
    }

    .entry-author {
      font-size: 0.9rem;
    }
  }
</style>
