---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const notes = (await getCollection('notes')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const formatDate = (date: Date) => new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC'
}).format(date);
---

<BaseLayout title="Notes" description="Notes by Ignacio Saldivia Gonzatti">
  <header class="page-header">
    <h1>Notes</h1>
  </header>

  <ol class="notes-list">
    {notes.map((note) => (
      <li>
        <p class="note-date">{formatDate(note.data.date)}</p>
        <h2><a href={`/notes/${note.id}/`}>{note.data.title}</a></h2>
        <p>{note.data.description}</p>
      </li>
    ))}
  </ol>
</BaseLayout>

<style>
  .notes-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .notes-list li {
    padding-block: 2rem;
    border-top: 1px solid var(--line);
  }

  .notes-list h2 {
    margin-bottom: 0.75rem;
    font-size: clamp(1.35rem, 3vw, 1.8rem);
  }

  .notes-list h2 a {
    text-decoration: none;
  }

  .notes-list h2 a:hover {
    text-decoration: underline;
  }

  .note-date {
    margin-bottom: 0.65rem;
    color: var(--muted);
    font-size: 0.8rem;
  }

  .notes-list li > p:last-child {
    margin-bottom: 0;
  }
</style>
