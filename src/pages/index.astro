---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import AboutContent from '../components/AboutContent.astro';
import ContactForm from '../components/ContactForm.astro';
import avatar from '../assets/avatar.jpg';
---

<BaseLayout wide>
  <section class="home-hero">
    <div class="home-image-frame">
      <img
        class="home-image"
        src="/img/myfortressview.jpg"
        alt="View from My Fortress"
        width="1200"
        height="800"
      />
    </div>
    <div class="home-poem">
      <p class="subtitle">Since you got here, you might as well read a poem.</p>
      <blockquote>
        <p><em>I Go Down To The Shore</em></p>
        <p>
          I go down to the shore in the morning<br />
          and depending on the hour the waves<br />
          are rolling in or moving out,<br />
          and I say, oh, I am miserable,<br />
          what shall—<br />
          what should I do? And the sea says<br />
          in its lovely voice:<br />
          Excuse me, I have work to do.
        </p>
        <cite>— Mary Oliver</cite>
      </blockquote>
    </div>
  </section>

  <div class="home-sections">
    <section id="about" class="expanded-section">
      <div class="section-heading about-heading">
        <h2>About</h2>
        <img
          class="about-avatar"
          src={avatar.src}
          alt="Ignacio Saldivia Gonzatti"
          width="680"
          height="680"
        />
        <div class="about-socials">
          <SocialLinks />
        </div>
      </div>
      <AboutContent />
    </section>

    <section id="resume">
      <h2><a class="section-title-link" href="/resume/">Résumé</a></h2>
      <p>Résumé of Ignacio Saldivia Gonzatti</p>
    </section>

    <section id="publications">
      <h2><a class="section-title-link" href="/publications/">Publications</a></h2>
      <p>Projects I contributed to that have been published in peer-reviewed journals</p>
    </section>

    <section id="notes">
      <h2><a class="section-title-link" href="/notes/">Notes</a></h2>
      <ul class="home-note-list">
        <li>
          <a href="/foodsheds/">Safeguarding Food Security in Tamale: A Case Study</a>
        </li>
        <li>
          <a href="/project/thesismsc/">MSc Thesis</a>
        </li>
      </ul>
    </section>

    <section id="anthology">
      <h2><a class="section-title-link" href="/anthology/">Anthology</a></h2>
      <p>A collection of my favourite poems, excerpts from books, and other writings.</p>
    </section>

    <section id="contact" class="expanded-section">
      <div class="section-heading">
        <h2>Contact Me</h2>
        <p>
          Interested in working together? Questions about my projects? Send me
          a message and let's grab a coffee.
        </p>
      </div>
      <ContactForm />
    </section>
  </div>
</BaseLayout>

<style>
  :global(#main-content) {
    padding-top: clamp(1.5rem, 4vw, 3rem);
  }

  .home-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(20rem, 0.8fr);
    align-items: stretch;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  .home-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    min-height: 0;
    filter: grayscale(1);
    object-fit: cover;
    object-position: 70% center;
  }

  .home-image-frame {
    position: relative;
    min-height: 0;
    overflow: hidden;
  }

  .home-poem {
    display: flex;
    align-items: flex-start;
    flex-direction: column;
    justify-content: center;
    padding: 0 clamp(1.5rem, 3vw, 3rem);
  }

  .subtitle {
    margin-bottom: 0.5rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  blockquote {
    margin: 1rem 0 1.5rem;
  }

  blockquote p {
    margin-bottom: 1rem;
    line-height: 1.5;
  }

  cite {
    color: var(--muted);
    font-size: 0.9rem;
    font-style: normal;
  }

  .home-sections {
    border-top: 1px solid var(--ink);
  }

  .home-sections section {
    display: grid;
    grid-template-columns: minmax(9rem, 0.35fr) minmax(0, 1fr);
    gap: 2rem;
    align-items: start;
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
    border-bottom: 1px solid var(--line);
  }

  .home-sections section:last-child {
    border-bottom: 0;
  }

  .section-title-link {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-transform: uppercase;
    text-underline-offset: 0.18em;
  }

  .home-sections .expanded-section {
    grid-template-columns: minmax(12rem, 0.35fr) minmax(0, 1fr);
  }

  .section-heading p {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .about-avatar {
    width: min(100%, 12rem);
    margin: 2rem auto 0;
    aspect-ratio: 1;
    border-radius: 50%;
    filter: grayscale(1) contrast(0.9);
    object-fit: cover;
  }

  .about-heading h2 {
    text-align: center;
    text-transform: lowercase;
  }

  .home-sections > section > h2,
  .home-sections > section > p,
  .home-sections > section > ul,
  .section-heading h2,
  .section-heading p {
    margin: 0;
  }

  .home-sections > section > h2,
  .section-heading h2 {
    font-size: clamp(1.4rem, 3vw, 2rem);
  }

  .about-socials {
    width: 100%;
    margin-top: 1.75rem;
  }

  .about-socials :global(.social-links) {
    justify-content: center;
    gap: 1.25rem;
  }

  .about-socials :global(.social-links a) {
    color: var(--ink);
  }

  .about-socials :global(.social-icon) {
    font-size: 1.25rem;
  }

  .home-note-list {
    padding: 0;
    list-style: none;
  }

  .home-note-list li + li {
    margin-top: 0.75rem;
  }

  @media (max-width: 52rem) {
    .home-hero {
      grid-template-columns: 1fr;
      height: auto;
    }

    .home-image-frame {
      height: min(18rem, 42vh);
      min-height: 16rem;
    }

    .home-poem {
      padding-top: 1.5rem;
    }

    .home-sections section,
    .home-sections .expanded-section {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .about-avatar {
      width: 8rem;
    }
  }
</style>
